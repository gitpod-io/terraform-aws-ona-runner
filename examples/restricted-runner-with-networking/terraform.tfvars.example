aws_region         = "eu-central-1"
availability_zones = ["eu-central-1a", "eu-central-1b"]

runner_id    = "runner-id-from-ona"
runner_token = "runner-token-from-ona"
runner_name  = "ona-runner"
api_endpoint = "https://app.gitpod.io/api"

routable_vpc_cidr = "10.42.0.0/24"
runner_cgnat_cidr = "100.64.0.0/16"
# Egress inspection is enabled by default and recommended.
enable_firewall = true

# The bundled firewall.yaml permits GitHub, Linear, Jira Cloud's API,
# OpenAI's API, and MCR for both roles. Add TLS hostnames for both here;
# [] retains the baseline.
# Use a leading dot to allow a domain and its subdomains, e.g. ".example.com".
# AWS APIs and app.gitpod.io use the VPC endpoints and do not belong here.
firewall_allowed_domains = []

# To replace the baseline instead, copy firewall.yaml to firewall-custom.yaml,
# edit runner_allowed_domains and environment_allowed_domains independently,
# and uncomment this path. Keep additions empty.
# firewall_config_path = "./firewall-custom.yaml"

# Or use an existing policy instead of either allowlist option.
# firewall_policy_arn = "arn:aws:network-firewall:eu-central-1:123456789012:firewall-policy/customer-policy"

# NAT Gateway mode is self-contained and creates one gateway per availability
# zone. To use existing centralized egress instead, replace this with:
# egress = {
#   mode               = "transit_gateway"
#   transit_gateway_id = "tgw-0123456789abcdef0"
# }
egress = {
  mode = "nat_gateway"
}

tags = {
  Environment = "production"
}
